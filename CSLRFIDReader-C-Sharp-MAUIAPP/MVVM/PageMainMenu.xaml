<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:CSLHandheldReader_C_Sharp_MAUIAPP.Maui.ViewModels"
             x:DataType="local:ViewModelMainMenu"
             x:Class="CSLHandheldReader_C_Sharp_MAUIAPP.Maui.Views.PageMainMenu"
             Title="CSL Handheld RFID Reader">

    <Shell.TitleView>
        <StackLayout Orientation="Horizontal" HorizontalOptions="Fill" VerticalOptions="Fill" Spacing="10">
            <Image Source="main_logo.png" HeightRequest="38"  />
            <Label Text="C# MAUI"
                   FontSize="Title" 
                   TextColor="White" 
                   HorizontalOptions="Start" 
                   VerticalTextAlignment="Center" />
            
            <Label Text="{Binding labelAppVersion}"
                   FontSize="Small" 
                   TextColor="White" 
                   HorizontalOptions="EndAndExpand" 
                   VerticalTextAlignment="Center" 
                   HorizontalTextAlignment="End"
                   Padding="5"/>
        </StackLayout>
    </Shell.TitleView>

    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="0.21*" />
            <RowDefinition Height="0.21*" />
            <RowDefinition Height="0.21*" />
            <RowDefinition Height="0.21*" />
            <RowDefinition Height="0.12*" />
            <RowDefinition Height="0.04*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Read/Write -->
        <Frame Grid.Row="0" Grid.Column="0" 
               Margin="2" BorderColor="{StaticResource GrayTextColor}" 
               Padding="5" CornerRadius="5">
            <Frame.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding OnReadWriteButtonCommand}" CommandParameter="1"/>
            </Frame.GestureRecognizers>
            
            <Grid>
                <!-- Portrait Layout (default) -->
                <Grid x:Name="PortraitLayout1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="7.5*" />
                        <RowDefinition Height="2.5*" />
                    </Grid.RowDefinitions>
                    <Image Grid.Row="0" Source="write.png"/>
                    <Label Grid.Row="1" Text="Read/Write" TextColor="{StaticResource GrayTextColor}" 
                           FontSize="Large" HorizontalOptions="Center" FontAttributes="Bold" />
                </Grid>
                
                <!-- Landscape Layout (hidden by default, will be toggled via code-behind) -->
                <Grid x:Name="LandscapeLayout1" IsVisible="False">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="7*" />
                    </Grid.ColumnDefinitions>
                    <Image Grid.Column="0" Source="write.png" VerticalOptions="Center" HorizontalOptions="Center"/>
                    <Label Grid.Column="1" Text="Read/Write" TextColor="{StaticResource GrayTextColor}" 
                           FontSize="Large" VerticalOptions="Center" HorizontalOptions="Start" FontAttributes="Bold" />
                </Grid>
            </Grid>
        </Frame>

        <!-- Inventory -->
        <Frame Grid.Row="0" Grid.Column="1" 
               Margin="2" BorderColor="{StaticResource GrayTextColor}" 
               Padding="5" CornerRadius="5">
            <Frame.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding OnInventoryButtonCommand}" CommandParameter="1"/>
            </Frame.GestureRecognizers>
            
            <Grid>
                <!-- Portrait Layout (default) -->
                <Grid x:Name="PortraitLayout2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="7.5*" />
                        <RowDefinition Height="2.5*" />
                    </Grid.RowDefinitions>
                    <Image Grid.Row="0" Source="inventory.png"/>
                    <Label Grid.Row="1" Text="Inventory" TextColor="{StaticResource GrayTextColor}" 
                           FontSize="Large" HorizontalOptions="Center" FontAttributes="Bold" />
                </Grid>
                
                <!-- Landscape Layout (hidden by default) -->
                <Grid x:Name="LandscapeLayout2" IsVisible="False">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="7*" />
                    </Grid.ColumnDefinitions>
                    <Image Grid.Column="0" Source="inventory.png" VerticalOptions="Center" HorizontalOptions="Center"/>
                    <Label Grid.Column="1" Text="Inventory" TextColor="{StaticResource GrayTextColor}" 
                           FontSize="Large" VerticalOptions="Center" HorizontalOptions="Start" FontAttributes="Bold" />
                </Grid>
            </Grid>
        </Frame>

        <!-- Register Tag -->
        <Frame Grid.Row="1" Grid.Column="0" 
               Margin="2" BorderColor="{StaticResource GrayTextColor}" 
               Padding="5" CornerRadius="5">
            <Frame.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding OnRegisterTagButtonCommand}" CommandParameter="1"/>
            </Frame.GestureRecognizers>
            
            <Grid>
                <!-- Portrait Layout (default) -->
                <Grid x:Name="PortraitLayout3">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="7.5*" />
                        <RowDefinition Height="2.5*" />
                    </Grid.RowDefinitions>
                    <Image Grid.Row="0" Source="register.png"/>
                    <Label Grid.Row="1" Text="Register Tag" TextColor="{StaticResource GrayTextColor}" 
                           FontSize="Large" HorizontalOptions="Center" FontAttributes="Bold" />
                </Grid>
                
                <!-- Landscape Layout (hidden by default) -->
                <Grid x:Name="LandscapeLayout3" IsVisible="False">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="7*" />
                    </Grid.ColumnDefinitions>
                    <Image Grid.Column="0" Source="register.png" VerticalOptions="Center" HorizontalOptions="Center"/>
                    <Label Grid.Column="1" Text="Register Tag" TextColor="{StaticResource GrayTextColor}" 
                           FontSize="Large" VerticalOptions="Center" HorizontalOptions="Start" FontAttributes="Bold" />
                </Grid>
            </Grid>
        </Frame>

        <!-- Special Func -->
        <Frame Grid.Row="1" Grid.Column="1" 
               Margin="2" BorderColor="{StaticResource GrayTextColor}" 
               Padding="5" CornerRadius="5">
            <Frame.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding OnSpecialFuncButtonCommand}" CommandParameter="1"/>
            </Frame.GestureRecognizers>
            
            <Grid>
                <!-- Portrait Layout (default) -->
                <Grid x:Name="PortraitLayout4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="7.5*" />
                        <RowDefinition Height="2.5*" />
                    </Grid.RowDefinitions>
                    <Image Grid.Row="0" Source="function.png"/>
                    <Label Grid.Row="1" Text="Special Func" TextColor="{StaticResource GrayTextColor}" 
                           FontSize="Large" HorizontalOptions="Center" FontAttributes="Bold" />
                </Grid>
                
                <!-- Landscape Layout (hidden by default) -->
                <Grid x:Name="LandscapeLayout4" IsVisible="False">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="7*" />
                    </Grid.ColumnDefinitions>
                    <Image Grid.Column="0" Source="function.png" VerticalOptions="Center" HorizontalOptions="Center"/>
                    <Label Grid.Column="1" Text="Special Func" TextColor="{StaticResource GrayTextColor}" 
                           FontSize="Large" VerticalOptions="Center" HorizontalOptions="Start" FontAttributes="Bold" />
                </Grid>
            </Grid>
        </Frame>

        <!-- Geiger Search -->
        <Frame Grid.Row="2" Grid.Column="0" 
               Margin="2" BorderColor="{StaticResource GrayTextColor}" 
               Padding="5" CornerRadius="5">
            <Frame.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding OnGeigerButtonCommand}" CommandParameter="1"/>
            </Frame.GestureRecognizers>
            
            <Grid>
                <!-- Portrait Layout (default) -->
                <Grid x:Name="PortraitLayout5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="7.5*" />
                        <RowDefinition Height="2.5*" />
                    </Grid.RowDefinitions>
                    <Image Grid.Row="0" Source="search.png"/>
                    <Label Grid.Row="1" Text="Geiger Search" TextColor="{StaticResource GrayTextColor}" 
                           FontSize="Large" HorizontalOptions="Center" FontAttributes="Bold" />
                </Grid>
                
                <!-- Landscape Layout (hidden by default) -->
                <Grid x:Name="LandscapeLayout5" IsVisible="False">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="7*" />
                    </Grid.ColumnDefinitions>
                    <Image Grid.Column="0" Source="search.png" VerticalOptions="Center" HorizontalOptions="Center"/>
                    <Label Grid.Column="1" Text="Geiger Search" TextColor="{StaticResource GrayTextColor}" 
                           FontSize="Large" VerticalOptions="Center" HorizontalOptions="Start" FontAttributes="Bold" />
                </Grid>
            </Grid>
        </Frame>

        <!-- Settings -->
        <Frame Grid.Row="2" Grid.Column="1" 
               Margin="2" BorderColor="{StaticResource GrayTextColor}" 
               Padding="5" CornerRadius="5">
            <Frame.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding OnSettingButtonCommand}" CommandParameter="1"/>
            </Frame.GestureRecognizers>
            
            <Grid>
                <!-- Portrait Layout (default) -->
                <Grid x:Name="PortraitLayout6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="7.5*" />
                        <RowDefinition Height="2.5*" />
                    </Grid.RowDefinitions>
                    <Image Grid.Row="0" Source="settings.png"/>
                    <Label Grid.Row="1" Text="Settings" TextColor="{StaticResource GrayTextColor}" 
                           FontSize="Large" HorizontalOptions="Center" FontAttributes="Bold" />
                </Grid>
                
                <!-- Landscape Layout (hidden by default) -->
                <Grid x:Name="LandscapeLayout6" IsVisible="False">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="7*" />
                    </Grid.ColumnDefinitions>
                    <Image Grid.Column="0" Source="settings.png" VerticalOptions="Center" HorizontalOptions="Center"/>
                    <Label Grid.Column="1" Text="Settings" TextColor="{StaticResource GrayTextColor}" 
                           FontSize="Large" VerticalOptions="Center" HorizontalOptions="Start" FontAttributes="Bold" />
                </Grid>
            </Grid>
        </Frame>

        <!-- Security -->
        <Frame Grid.Row="3" Grid.Column="0" 
               Margin="2" BorderColor="{StaticResource GrayTextColor}" 
               Padding="5" CornerRadius="5">
            <Frame.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding OnSecurityButtonCommand}" CommandParameter="1"/>
            </Frame.GestureRecognizers>
            
            <Grid>
                <!-- Portrait Layout (default) -->
                <Grid x:Name="PortraitLayout7">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="7.5*" />
                        <RowDefinition Height="2.5*" />
                    </Grid.RowDefinitions>
                    <Image Grid.Row="0" Source="security.png"/>
                    <Label Grid.Row="1" Text="Security" TextColor="{StaticResource GrayTextColor}" 
                           FontSize="Large" HorizontalOptions="Center" FontAttributes="Bold" />
                </Grid>
                
                <!-- Landscape Layout (hidden by default) -->
                <Grid x:Name="LandscapeLayout7" IsVisible="False">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="7*" />
                    </Grid.ColumnDefinitions>
                    <Image Grid.Column="0" Source="security.png" VerticalOptions="Center" HorizontalOptions="Center"/>
                    <Label Grid.Column="1" Text="Security" TextColor="{StaticResource GrayTextColor}" 
                           FontSize="Large" VerticalOptions="Center" HorizontalOptions="Start" FontAttributes="Bold" />
                </Grid>
            </Grid>
        </Frame>

        <!-- RFID Filter -->
        <Frame Grid.Row="3" Grid.Column="1" 
               Margin="2" BorderColor="{StaticResource GrayTextColor}" 
               Padding="5" CornerRadius="5">
            <Frame.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding OnFilterButtonCommand}" CommandParameter="1"/>
            </Frame.GestureRecognizers>
            
            <Grid>
                <!-- Portrait Layout (default) -->
                <Grid x:Name="PortraitLayout8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="7.5*" />
                        <RowDefinition Height="2.5*" />
                    </Grid.RowDefinitions>
                    <Image Grid.Row="0" Source="filter.png"/>
                    <Label Grid.Row="1" Text="RFID Filter" TextColor="{StaticResource GrayTextColor}" 
                           FontSize="Large" HorizontalOptions="Center" FontAttributes="Bold" />
                </Grid>
                
                <!-- Landscape Layout (hidden by default) -->
                <Grid x:Name="LandscapeLayout8" IsVisible="False">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="7*" />
                    </Grid.ColumnDefinitions>
                    <Image Grid.Column="0" Source="filter.png" VerticalOptions="Center" HorizontalOptions="Center"/>
                    <Label Grid.Column="1" Text="RFID Filter" TextColor="{StaticResource GrayTextColor}" 
                           FontSize="Large" VerticalOptions="Center" HorizontalOptions="Start" FontAttributes="Bold" />
                </Grid>
            </Grid>
        </Frame>

        <!-- Connect Button -->
        <Frame Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" 
               Margin="2" BorderColor="{StaticResource GrayTextColor}" 
               Padding="5" CornerRadius="5">
            <Frame.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding OnConnectButtonCommand}" CommandParameter="1"/>
            </Frame.GestureRecognizers>
            <Label Text="{Binding connectedButton}" 
                   TextColor="{Binding connectedButtonTextColor}" 
                   FontSize="Medium" 
                   HorizontalOptions="Center" 
                   VerticalOptions="Center" 
                   FontAttributes="Bold" />
        </Frame>

        <!-- Voltage Label -->
        <Label Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" 
               Text="{Binding labelVoltage}"
               TextColor="{Binding labelVoltageTextColor}"
               Margin="2"
               HorizontalOptions="Fill"
               VerticalOptions="Fill" />

    </Grid>

</ContentPage>










